{
  "name": "react-datakit",
  "version": "0.2.0",
  "description": "Headless, accessible React components for data-heavy apps: Combobox, MultiSelect and DateRangePicker.",
  "keywords": [
    "react",
    "headless",
    "accessibility",
    "a11y",
    "wai-aria",
    "combobox",
    "multiselect",
    "date-range-picker",
    "typescript"
  ],
  "license": "MIT",
  "author": "Stefan Milutinović",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanmilutinovicrs/react-datakit.git"
  },
  "bugs": {
    "url": "https://github.com/stefanmilutinovicrs/react-datakit/issues"
  },
  "homepage": "https://github.com/stefanmilutinovicrs/react-datakit#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./combobox": {
      "import": {
        "types": "./dist/combobox/index.d.ts",
        "default": "./dist/combobox/index.js"
      },
      "require": {
        "types": "./dist/combobox/index.d.cts",
        "default": "./dist/combobox/index.cjs"
      }
    },
    "./multiselect": {
      "import": {
        "types": "./dist/multiselect/index.d.ts",
        "default": "./dist/multiselect/index.js"
      },
      "require": {
        "types": "./dist/multiselect/index.d.cts",
        "default": "./dist/multiselect/index.cjs"
      }
    },
    "./daterangepicker": {
      "import": {
        "types": "./dist/daterangepicker/index.d.ts",
        "default": "./dist/daterangepicker/index.js"
      },
      "require": {
        "types": "./dist/daterangepicker/index.d.cts",
        "default": "./dist/daterangepicker/index.cjs"
      }
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.cts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit && node node_modules/typescript-7/bin/tsc -p tsconfig.test-d.json",
    "test": "vitest run --project node --project chromium",
    "test:watch": "vitest --project chromium",
    "test:all-browsers": "vitest run",
    "test:visual": "node scripts/visual.ts",
    "test:visual:update": "node scripts/visual.ts --update",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "publint && attw --pack . --profile node16",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "new-component": "node scripts/new-component.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.8",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-browser-react": "^2.3.0"
  }
}
