{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "ignorePaths": ["**/node_modules/**"],
  "rangeStrategy": "bump",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies (non-major)",
      "automerge": true
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1.0",
      "description": "typescript-eslint and the dts build still need the TS 6 JavaScript API; TS 7 is installed as typescript-7."
    },
    {
      "matchFileNames": ["test/next-app/package.json"],
      "rangeStrategy": "pin",
      "groupName": "Next.js fixture",
      "description": "The fixture pins exact versions; config:recommended would skip it as a test folder, hence ignorePaths."
    },
    {
      "matchFileNames": ["test/next-app/package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["playwright", "@playwright/test"],
      "groupName": "Playwright",
      "description": "Same version in the root and the fixture, so both use the same downloaded browsers."
    }
  ]
}
